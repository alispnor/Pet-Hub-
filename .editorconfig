# https://editorconfig.org
# Padroniza estilo de código entre IDEs.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 120

[*.{kt,kts}]
indent_size = 4

[*.{js,ts,tsx,jsx,html,css,scss,sass,json,yml,yaml,xml,md}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{md,mdx}]
trim_trailing_whitespace = false

[{*.bat,*.cmd}]
end_of_line = crlf
