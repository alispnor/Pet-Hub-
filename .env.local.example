# =====================================================================
# Pet Hub — variáveis de ambiente para desenvolvimento local
#
# Copie este arquivo para `.env.local` (gitignored) e ajuste o necessário:
#   cp .env.local.example .env.local
#
# Subir infra com este arquivo:
#   docker compose --env-file .env.local -f infrastructure/docker/docker-compose.dev.yml up -d
#
# Rodar a app passando as mesmas variáveis (via export ou IDE):
#   set -a && source .env.local && set +a
#   cd backend && mvn -pl application spring-boot:run
# =====================================================================

# --- Postgres ---
POSTGRES_DB=pethub
POSTGRES_USER=pethub
POSTGRES_PASSWORD=pethub
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- pgAdmin (UI em http://localhost:${PGADMIN_PORT}) ---
PGADMIN_EMAIL=admin@pethub.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Backend Spring Boot (lido por application.yml) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/pethub
DATABASE_USER=pethub
DATABASE_PASSWORD=pethub
SPRING_PROFILES_ACTIVE=dev

# --- Segurança (NUNCA commitar valores reais de produção) ---
# Gere com: openssl rand -base64 32
APP_ENCRYPTION_KEY=8E+PGOrLeLUCDk1d6BkIwRl9DYE19UdPcAxV90Ob7mg=
# Gere com: openssl rand -base64 64
JWT_SECRET=dev-only-secret-please-override-in-prod-at-least-32-chars-long

# --- CORS ---
# Storefront roda na porta 4242 (alinhado com `npm start`). Admin SPA (Fase 6)
# vai usar 4201. Manter localhost:4200 só por compat com setups antigos.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4242,http://localhost:4242,http://localhost:4201,http://localhost:4200

# --- Uploads (fotos de pet, etc.) ---
APP_UPLOADS_DIR=var/uploads
APP_UPLOADS_PUBLIC_BASE_URL=http://localhost:8080/files
APP_UPLOADS_MAX_BYTES=5242880

# --- ViaCEP (proxy de consulta de CEP, cacheado 24h em Redis) ---
VIACEP_BASE_URL=https://viacep.com.br
